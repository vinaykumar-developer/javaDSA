class Solution {
    public int minCost(int[] arr) {
        if(arr.length==1) return 0;
        if(arr.length==2) return (arr[0]+arr[1]);
        PriorityQueue<Integer> pq= new PriorityQueue<>();
        for(int ele: arr){
            pq.add(ele);
        }
        int sum=0;
        while(pq.size()>2){
            int x=pq.remove(); int y=pq.remove();
             int temp=x+y ;   sum+=temp;
             pq.add(temp);
        }
        int x=pq.remove(); int y=pq.remove();
        sum+=(x+y);
        return sum;
        
    }
}
