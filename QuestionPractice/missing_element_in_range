class Solution {
    public ArrayList<Integer> missingRange(int[] arr, int low, int high) {
        // code here
        Set<Integer> set =new HashSet<>();
        ArrayList<Integer> list = new ArrayList<>(); 
        for( int ele: arr) set.add(ele);
        int j=0;
        for(int i=low;i<=high;i++){
            if(!set.contains(i)){
                list.add(i);
            }
        }
        return list;
     }
}
