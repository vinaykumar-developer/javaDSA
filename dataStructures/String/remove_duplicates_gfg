class Solution {
    public String removeDuplicates(String s) {
        // code here
        StringBuilder sb= new StringBuilder();
        sb.append(s.charAt(0));
        char temp=sb.charAt(0);
        for(int i=0;i<s.length();i++){
            char ch =s.charAt(i);
            if(ch==temp);
            else {
            sb.append(ch);
            temp=ch;
            }
        }
        return sb.toString();
    }
}
