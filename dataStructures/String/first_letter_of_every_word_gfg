class Solution {
    String firstAlphabet(String s) {
        // code here
        if(s.length()==0) return "";
        StringBuilder sb= new StringBuilder();
        sb.append(s.charAt(0));
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch==' ') {
                if(i+1<s.length()){
                    sb.append(s.charAt(i+1));
                }
            }
        }
        return sb.toString();
    }
};
