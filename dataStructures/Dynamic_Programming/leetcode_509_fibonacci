class Solution {
    static int[] dp;
    public int fib(int n) {
        dp = new int[n+1];
        return fibdp(n);
    }
    private int fibdp(int n){
        if(n<=1) return n;
        if(dp[n]!=0)  return dp[n];
        int ans=fibdp(n-1) + fibdp(n-2);
        dp[n]=ans;
        return ans;
    }
}
