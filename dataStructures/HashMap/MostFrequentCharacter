class Solution {
    public static char getMaxOccuringChar(String s) {
        // code here
        HashMap<Character,Integer> map= new HashMap<>();
        for( int i=0;i<s.length();i++){
            char ch= s.charAt(i);
            if(map.containsKey(ch)){
                int freq=map.get(ch);
                map.put(ch,freq+1);
            }
            else{
                map.put(ch,1);
            }
        }
        int max=0;
        char op=' ';
        for( char ch : map.keySet()){
            int freq = map.get(ch);
            
            if(freq>max){
                max=freq;
                op=ch;
            }
            if(freq==max && op>ch){
             op=ch;
            }
        }
        return op;
    }
}
