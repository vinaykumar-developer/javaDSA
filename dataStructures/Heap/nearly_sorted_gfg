class Solution {
    public void nearlySorted(int[] arr, int k) {
        // code here
        int i=0;
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int ele: arr){
            pq.add(ele);
            if(pq.size()>k){
                arr[i]=pq.remove();
                i++;
            }
            
        }
        while(pq.size()>0){
                arr[i]=pq.remove();
                i++;
            }
    }
}
