class Solution {
    public int lastStoneWeight(int[] stones) {
        PriorityQueue<Integer> pq= new PriorityQueue<>(Collections.reverseOrder());
        if(stones.length==1) return stones[0];
        if(stones.length==2) {
            if(stones[0]==stones[1]) return 0;
            else return (Math.abs(stones[1]-stones[0]));
        }
        for(int i=0;i<stones.length;i++){
            pq.add(stones[i]);
        }
        while(pq.size()>2){
            int y=pq.remove();
            int x=pq.remove();
            if(x!=y){
                pq.add(y-x);
            }
        }
        if(pq.size()==2){
            int y=pq.remove();
            int x=pq.remove();
            if(x==y) return 0;
            else return (y-x);
        }else{
            return pq.remove();
        }
        

    }
}
