class Solution {
    static String decToBinary(int n) {
        // code here
        StringBuilder sb = new StringBuilder();
        while(n>0){
            int remender=n%2;
            sb.append(remender);
            n=n/2;
        }
        if(n==1) sb.append(1);
        sb.reverse();
        return sb.toString();
        
    }
}
