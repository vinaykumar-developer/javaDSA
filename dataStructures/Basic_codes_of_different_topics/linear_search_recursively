public class Main
{
	public static void main(String[] args) {
		int[] arr= {1,2,3,4,5,6,7,8,9};
		recPrint(arr,arr.length-1);
                int k=9;
                System.out.print(recSearch(arr,k,0));
	}
	public static void recPrint(int[] arr,  int idx){
	        if(idx==-1) return ;
	        System.out.print(arr[idx]+" ");
	        recPrint(arr,idx-1);
	}
	public static boolean recSearch(int[] arr, int val,int idx){
	        if(idx==arr.length-1) return false;
	        if(arr[idx]==val) return true;
	        return recSearch(arr,val,idx+1);
	}
}
