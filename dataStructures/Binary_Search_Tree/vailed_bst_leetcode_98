/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private double[] prev={Long.MIN_VALUE,1,1};
    public boolean isValidBST(TreeNode root) {
        if(root.left==null && root.right==null) return true;
        check(root);
        if(prev[1]==1) return true;
        else return false;
    }
    private void check(TreeNode root){
        if(root==null) return ;
        check(root.left);
        if(root.val>prev[0]){
            prev[0]=root.val;
            check(root.right);
        }
        else {
            prev[1]=0;
        }
        return ;

    }
}
