/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode result = new ListNode();
        ListNode head=result;
        int carry =0;
        ListNode h1=l1;
        ListNode h2=l2;
        while(h1!=null && h2!=null){
            int sum =h1.val + h2.val + carry ;
            h1=h1.next; h2=h2.next;
            if(sum>9){
                sum=sum%10;
                carry=1;
            }
            else carry=0;
            ListNode nw = new ListNode(sum);
            result.next=nw;
            result=result.next;
        }
        while(h1!=null){
            int sum =h1.val + carry ;
            h1=h1.next;
            if(sum>9){
                sum=sum%10;
                carry=1;
            }else carry=0;
            ListNode nw = new ListNode(sum);
            result.next=nw;
            result=result.next;
        }
        while(h2!=null){
            int sum =h2.val + carry;
            h2=h2.next;
            if(sum>9){
                sum=sum%10;
                carry=1;
            }
            else carry=0;
            ListNode nw = new ListNode(sum);
            result.next=nw;
            result=result.next;
        }
        if(carry==1){
            ListNode nw= new ListNode(carry);
            result.next=nw;
        }
        return head.next;
    }
}
