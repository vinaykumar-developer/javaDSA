class Solution {
    public int reverse(int x) {
        boolean isnegative=false;
        if(x==0) return 0;
        if(x<0){
            isnegative=true;
            x=-x;
        }
        while(x%10==0){
            x=x/10;
        }
        long n=0;
        while(x>0){
            n= n*10 + x%10;
            x=x/10;
        }
        if(n>Integer.MAX_VALUE || n<Integer.MIN_VALUE)  return 0;
        else if(isnegative) return (int)-n;
        return (int)n;
    }
}
