/* Linked List Node Structure
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
} */

class Solution {
    int getMiddle(Node head) {
        // code here
        Node temp=head;
        int count =0;
        while(temp!=null){
            count++;
            temp=temp.next;
        }
        Node temp2=head;
        int i=1;
        while(i<count/2){
        temp2=temp2.next;
        i++;
        }
        return  temp2.next.data;
    }
}
