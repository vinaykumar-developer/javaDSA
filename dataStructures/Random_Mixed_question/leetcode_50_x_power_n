class Solution {
    public double myPow(double x, int n){
        long N=n;
        if(n<0){
            N=-N;
        }
        double ans =pow(x,N);
        return (n<0?1/ans:ans);
    }
    public double pow(double x, long n){
        if(n==0) return 1.0;
        double ans = pow(x,n/2);
        if(n%2==0) return ans*ans;
        else return x*ans*ans;
    }
}
