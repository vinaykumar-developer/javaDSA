class Solution {
    public boolean isPalindrome(int x) {
        if(x<0) return false;
         int n=0;
         int m=x;
         while(m>0){
             int temp=m%10;
             n*=10;
             n+=temp;
             m=m/10;
        }
        if(x==n) return true;
        return false;
    }
}
