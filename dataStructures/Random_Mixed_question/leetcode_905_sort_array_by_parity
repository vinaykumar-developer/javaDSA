class Solution {
    public int[] sortArrayByParity(int[] nums) {
       if (nums.length==1) return nums;
       int e=0;
       int o=nums.length-1;
       int i=0;
       while(e<o){
        // both are at correct position
        if(nums[e]%2==0 && nums[o]%2==1){
            e++; o--;
        }
        // both are even 
        else if(nums[e]%2==0 && nums[o]%2==0){
            e++;
        }
        // both are odd
        else if(nums[e]%2==1 && nums[o]%2==1){
            o--;

        }
        // first one is odd and 2nd one is even 
        else if(nums[e]%2==1 && nums[o]%2==0){
            int temp=nums[e];
            nums[e]=nums[o];
            nums[o]=temp;
            e++;o--;
        }
       }
       return nums;

    }

}
