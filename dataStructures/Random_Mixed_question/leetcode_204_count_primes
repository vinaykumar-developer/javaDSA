class Solution {
    public int countPrimes(int n) {
        if(n<2) return 0;
        boolean[] arr = new boolean[n];// initially automaticaly set as fasle on each index
        for(int i=2;i<Math.sqrt(n);i++){
            if(!arr[i]){
                for(int j=i*i;j<n;j+=i){
                    arr[j]=true;
                }
            }
        }
        int count =0;
        for(int i=2;i<n;i++){
            if(!arr[i]) count++;
        }
        return count;
    }
}
