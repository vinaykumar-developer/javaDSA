class Solution {
    public boolean isPalindrome(String s) {
        String st= s.toLowerCase();
        int i=0;
        int j=s.length()-1;
        while(i<j){
            char start = st.charAt(i);
            char end = st.charAt(j);
            if(!Character.isLetterOrDigit(start)) i++;
            else if(!Character.isLetterOrDigit(end)) j--;
            // else if(st.charAt(start)!=st.charAt(end)) return false;
            else if(start!=end) return false;
            else{
                i++;
                j--;
            }
        }
        return true;
    }
}
