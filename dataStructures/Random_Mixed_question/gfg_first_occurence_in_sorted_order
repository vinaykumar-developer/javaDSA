class Solution {
    public int firstSearch(int[] arr, int k) {
        // Code Here
        int lo=0,hi=arr.length-1,ind=-1;
        while(lo<=hi){
            int mid=(lo+hi)/2;
            if(arr[mid]==k) {
                hi=mid-1 ;
                ind=mid;
                
            }
            else if(arr[mid]<k) lo=mid+1;
            else if(arr[mid]>k) hi=mid-1;
        }
        return ind;
    }
}
